class Solution {
    public int[] sortArrayByParity(int[] nums) {
        int left = 0;
        int right = nums.length - 1;

        while (left < right) {
            // Increment left if the current element is even
            if (nums[left] % 2 == 0) {
                left++;
            } 
            // Decrement right if the current element is odd
            else if (nums[right] % 2 != 0) {
                right--;
            } 
            // If left is odd and right is even, swap them
            else {
                int temp = nums[left];
                nums[left] = nums[right];
                nums[right] = temp;
                left++;
                right--;
            }
        }

        return nums;
    }
}
